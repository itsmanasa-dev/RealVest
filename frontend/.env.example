# RealVest Frontend Environment Variables
# Copy this file to .env or .env.local and fill in the values.
# NEVER commit .env with real credentials to Git.

# Live FastAPI backend URL (Render URL in production, http://localhost:8000 in dev)
VITE_API_URL=http://localhost:8000

# Firebase Web Application Configuration
# Obtain these values from your Firebase Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
