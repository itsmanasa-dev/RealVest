# RealVest Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# URL of the live FastAPI backend (Render URL in production, localhost in dev)
# IMPORTANT: VITE_ variables are browser-visible. Do NOT put secrets here.
VITE_API_URL=http://localhost:8000

# Firebase Authentication (Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Backend (FastAPI) ──────────────────────────────────────────────────────
# Full MySQL connection string. Required. No SQLite fallback.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/realvest

# Comma-separated list of allowed CORS origins (Vercel frontend URL in production)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Official Google Gemini API Key (Backend Only — NEVER expose as VITE_GEMINI_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash


